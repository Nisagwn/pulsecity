{
  "title": "PulseCity - Canlı Trafik Boru Hattı",
  "uid": "pulsecity-main",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Throughput (üretilen / işlenen msg/sn)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(pulsecity_producer_messages_total[30s])",
          "legendFormat": "üretilen (producer)"
        },
        {
          "expr": "sum(rate(pulsecity_consumer_messages_processed_total[30s]))",
          "legendFormat": "işlenen (consumer)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Hata / DLQ oranı (msg/sn)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(pulsecity_producer_errors_total[30s])",
          "legendFormat": "producer hataları"
        },
        {
          "expr": "sum(rate(pulsecity_consumer_dlq_total[30s]))",
          "legendFormat": "DLQ'ya yönlendirilen"
        }
      ]
    },
    {
      "id": 3,
      "title": "Bölge bazlı araç yoğunluğu (ping/sn)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (zone_id) (rate(pulsecity_vehicle_pings_by_zone_total[30s]))",
          "legendFormat": "{{zone_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bölge bazlı ortalama hız (km/h)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "avg by (zone_id) (pulsecity_vehicle_avg_speed_kmh)",
          "legendFormat": "{{zone_id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "ScyllaDB batch yazma süresi (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pulsecity_consumer_batch_write_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pulsecity_consumer_batch_write_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pulsecity_consumer_batch_write_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "title": "Toplam işlenen mesaj (kümülatif)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(pulsecity_consumer_messages_processed_total)",
          "legendFormat": "toplam işlenen"
        }
      ]
    },
    {
      "id": 7,
      "title": "Bölge bazlı anomali durumu",
      "description": "1 = bölgenin ortalama hızı öğrenilen normalin %40'ından fazla altına düştü (olası tıkanıklık/kaza).",
      "type": "state-timeline",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "normal",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "ANOMALİ",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "max by (zone_id) (pulsecity_zone_anomaly_detected)",
          "legendFormat": "{{zone_id}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Mevcut hız vs öğrenilen baseline (km/h)",
      "description": "Kesintisiz çizgiler o anki ortalama hız, baseline ise EMA ile öğrenilen normal. Baseline anomali sırasında bilerek güncellenmez — yoksa uzun süreli tıkanıklık 'yeni normal' olur.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*baseline.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "avg by (zone_id) (pulsecity_vehicle_avg_speed_kmh)",
          "legendFormat": "{{zone_id}} mevcut"
        },
        {
          "expr": "avg by (zone_id) (pulsecity_zone_speed_baseline_kmh)",
          "legendFormat": "{{zone_id}} baseline"
        }
      ]
    },
    {
      "id": 9,
      "title": "Son uyarı ve hatalar (tüm servisler)",
      "description": "Faz 17: Loki'den canlı log akışı. Metrikler 'ne kadar', loglar 'neden' sorusunu yanıtlar. Sorgu seviye ETİKETİNE göre filtreliyor — bu yüzden log içeriğini taramak zorunda kalmıyor ve hızlı.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_service=~\"producer|consumer|webviz\", level=~\"WARN|ERROR\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}