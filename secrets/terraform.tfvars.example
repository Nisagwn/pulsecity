# infra/terraform/terraform.tfvars icin sablon.
#
# NEDEN BURADA: terraform.tfvars .gitignore'da (icinde operatorun IP'si var).
# Bu da su anlama geliyordu: altyapiyi hangi degerlerle ayaga kaldirdigin
# hicbir yerde kayitli degil - laptop degisince bilgi kayboluyor.
# SOPS ile sifreli olarak surumlenebilir hale geliyor.
#
# Kullanim:
#   cp secrets/terraform.tfvars.example secrets/terraform.tfvars.enc
#   # doldur, sonra:
#   ./scripts/secrets.sh encrypt secrets/terraform.tfvars.enc
#
# Kullanmak icin:
#   ./scripts/secrets.sh decrypt secrets/terraform.tfvars.enc \
#     > infra/terraform/terraform.tfvars

allowed_ssh_cidr = "203.0.113.42/32"
ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... kullanici@makine"
