# PulseCity — Production ortam değişkenleri (Faz 6)
# Kopyala: cp .env.example .env  ve değerleri doldur. .env dosyasını ASLA commit etme.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Faz 9'dan sonra kök adres canlı haritaya ayrıldı, Grafana /grafana/ alt yoluna
# taşındı. Bu değer MUTLAKA /grafana/ ile bitmeli; aksi halde Grafana kendi
# CSS/JS asset linklerini yanlış üretir ve dashboard bozuk görünür.
GRAFANA_ROOT_URL=http://SUNUCU_IP_ADRESIN/grafana/

TARGET_RATE_PER_SEC=50000
VEHICLE_COUNT=20000
PRODUCER_WORKERS=4
