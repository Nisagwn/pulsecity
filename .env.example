# PulseCity — Production ortam değişkenleri (Faz 6)
# Kopyala: cp .env.example .env  ve değerleri doldur. .env dosyasını ASLA commit etme.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Faz 9'dan sonra kök adres canlı haritaya ayrıldı, Grafana /grafana/ alt yoluna
# taşındı. Bu değer MUTLAKA /grafana/ ile bitmeli; aksi halde Grafana kendi
# CSS/JS asset linklerini yanlış üretir ve dashboard bozuk görünür.
GRAFANA_ROOT_URL=http://SUNUCU_IP_ADRESIN/grafana/
# Oturum çerezi yalnızca HTTPS üzerinden gitsin mi? TLS'li (alan adı olan)
# kurulumda "true" yap. TLS'siz bir kurulumda true yapmak girişi sessizce
# kırar: tarayıcı çerezi hiç göndermez. Terraform yolunda cloud-init bunu
# domain'e bakarak kendisi yazar.
GRAFANA_COOKIE_SECURE=false

# Yük profili. Bu değerler DEPLOY.md'deki boyutlandırma tablosuna bağlıdır:
# 50.000 msg/sn Faz 3'te 12 çekirdek / 7,6 GB ile ölçüldü. 2 vCPU'lu bir
# t3.large'a bu hızı vermek consumer'ı kalıcı olarak geride bırakır ve lag
# Kafka'nın retention.bytes tavanına dayandığında segmentler okunmadan silinir
# — zero-loss iddiası tam da canlıda çürür. Aşağıdaki değerler t3.large içindir
# (local profille aynı); 50k için 4 vCPU / 16 GB'a çıkıp bu satırları büyüt.
TARGET_RATE_PER_SEC=5000
VEHICLE_COUNT=2000
PRODUCER_WORKERS=4
